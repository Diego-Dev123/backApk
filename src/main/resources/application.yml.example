server:
  port: 3000
  address: 0.0.0.0




spring:
  application:
    name: ApiRest

  datasource:
    url: jdbc:mysql://localhost:3306/apirest_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: root
    password: CHANGE_ME
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect

jwt:
  secret: ${JWT_SECRET:CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET}
